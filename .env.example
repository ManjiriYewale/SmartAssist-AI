# ===== SmartAssist AI configuration =====
# Copy this file to ".env" and fill in the values.   (Windows: copy .env.example .env)
# NEVER commit your real .env file.

# --- Groq LLM (https://console.groq.com/keys - free tier available) ---
GROQ_API_KEY=your_groq_api_key_here
# Any Groq model that supports tool calling. Change it here whenever Groq retires a model.
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.1

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=smartassist
# Optional: a full SQLAlchemy URL overrides the POSTGRES_* values above, e.g.
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/smartassist
# (URL-encode special characters in the password, e.g. @ -> %40)

# --- Storage ---
UPLOAD_DIR=data/uploads
CHROMA_DIR=data/chroma_db
MAX_UPLOAD_MB=25

# --- RAG ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5
MIN_RELEVANCE_SCORE=0.20

# --- Agent safety limits ---
MAX_AGENT_STEPS=4
MAX_TOOL_CALLS_PER_STEP=4

# --- API server (optional) ---
API_HOST=127.0.0.1
API_PORT=8000
# If set, every API request (except /health) must send the header  X-API-Key: <value>
API_AUTH_TOKEN=
LOG_LEVEL=INFO
